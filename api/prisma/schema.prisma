// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id      Int              @id @default(autoincrement())
  name    String
  imgUrl String
  levels  LevelCharacter[]

  @@map("characters")
}

model Level {
  id         Int              @id @default(autoincrement())
  name       String
  imgUrl    String
  characters LevelCharacter[]
  runs       Run[]

  @@map("levels")
}

model LevelCharacter {
  id Int @id @default(autoincrement())

  level    Level @relation(fields: [levelId], references: [id])
  levelId Int

  character    Character @relation(fields: [characterId], references: [id])
  characterId Int

  run_character RunCharacter[]

  x      Int
  y      Int
  width  Int
  height Int

  @@unique([levelId, characterId])
  @@map("level_characters")
}

model Run {
  id          Int       @id @default(autoincrement())
  sessionId  String
  name        String
  startTime  DateTime  @default(now())
  finishTime DateTime?
  levelId    Int
  level       Level     @relation(fields: [levelId], references: [id])

  characters RunCharacter[]

  @@index([sessionId])
  @@map("runs")
}

model RunCharacter {
  run    Run @relation(fields: [runId], references: [id])
  runId Int

  levelCharacter    LevelCharacter @relation(fields: [levelCharacterId], references: [id])
  levelCharacterId Int

  foundAt    DateTime   @default(now())

  @@id([runId, levelCharacterId])
  @@map("run_characters")
}
